# Copy to .env for local overrides. No value here is a secret; the project
# needs no API key or cloud credential. Never commit a real .env.

# MLflow tracking / model registry (default: sqlite:///mlflow.db in the repo root)
MLFLOW_TRACKING_URI=
# Where file-based MLflow stores put artifacts (default: ./mlruns)
MLFLOW_ARTIFACT_ROOT=

# Daily pipeline configuration (default: configs/pipeline.yaml) and data root override
FLEET_PIPELINE_CONFIG=
FLEET_DATA_ROOT=

# Hosted LLM summaries are NOT used (Week 3: template summaries only). If one is
# ever approved, its key goes here and nowhere else:
# ANTHROPIC_API_KEY=
